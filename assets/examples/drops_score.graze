task main() {
    drop(player(), 0, 500);
    drop(player(), 1, 1);
    drop(player(), 2, 1);
    let ship = enemy(vec(width() / 2.0, 100.0), vec(0.0, 0.0), 12.0, 20, 0, 0xffaaa0ff);
    enemy_drop(ship, 0, 1000);
    while alive(ship) {
        ring(position(ship), 8 + difficulty() * 4, 1.0 + fixed(difficulty()) * 0.5,
            0.0, 3.0, 420);
        wait(90);
    }
    cancel_shots(true);
    wait(400);
    complete();
}
